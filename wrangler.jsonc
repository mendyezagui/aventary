{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aventary",
  "compatibility_date": "2025-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "main": ".open-next/worker.js",
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  // Non-secret runtime config, declared here ON PURPOSE.
  //
  // These were set as plain-text variables in the Cloudflare dashboard and a
  // deploy silently removed them, which took sign-in email down twenty minutes
  // after it was first proved working.
  //
  // That is not a Cloudflare bug. A deploy replaces a Worker's plain-text vars
  // with whatever the config declares — declaring none means "remove them all".
  // Encrypted SECRETS are untouched, which is why RESEND_API_KEY survived the
  // same deploy and these two did not, and why the failure looked so arbitrary.
  //
  // So anything non-secret belongs here, in version control, where a deploy
  // restores it instead of erasing it. Neither of these is a credential: they
  // are the addresses the site sends from and to, both already public in
  // .env.example and on the contact page.
  //
  // Secrets stay out of this file and are set with `wrangler secret put` or in
  // the dashboard as type Secret: RESEND_API_KEY, SUPABASE_SERVICE_ROLE_KEY,
  // PAGE_FEED_SECRET, and anything else that would matter if it leaked.
  "vars": {
    // The anon-key Supabase connection. Both halves belong here, together.
    //
    // They were split across the two kinds of Worker config — the URL stored as
    // an encrypted Secret, the key as a plain-text Variable — and a deploy on
    // 2026-09-15 replaced the variables with what this file declared (nothing)
    // while leaving the secret alone. The result was a URL with no key, which
    // is worse than having neither: every guard checked only the URL, so the
    // code walked past it into createServerClient(url, undefined) and threw.
    // /, /insights, /videos, /contact and /diagnostics all returned 500.
    //
    // Neither value is a credential. NEXT_PUBLIC_ means it is compiled into the
    // browser bundle and served to every visitor; the anon key grants only what
    // row-level security allows, which is why Supabase publishes it. The
    // service-role key is the one that matters and it stays a Secret.
    //
    // Declared here, a deploy restores them. That is the whole point of this
    // block — see the note below on how these vars died the first time.
    "NEXT_PUBLIC_SUPABASE_URL": "https://uclyawqdeabjsrejfdlw.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InVjbHlhd3FkZWFianNyZWpmZGx3Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzgxNzU3OTAsImV4cCI6MjA5Mzc1MTc5MH0.tLyaOMCqiORGN5N6p4PcLvm86_1ziYRevznmEUljbb0",
    "CONTACT_FROM_EMAIL": "noreply@aventary.com",
    "CONTACT_TO_EMAIL": "mendy@aventary.com",
    // Which Supabase project serves project-page content. A public hostname,
    // already named in CLAUDE.md and the docs — the credential that goes with
    // it is PAGE_FEED_SECRET, which is a Secret and is not in this file.
    "SECOND_BRAIN_URL": "https://fukehjqikxqsntwhmgsk.supabase.co",
    // Who may reach /admin. An allowlist of addresses, not a credential — it
    // grants nothing on its own, since the holder still has to sign in through
    // Supabase auth. It belongs here for the same reason as the rest: it was a
    // plain-text dashboard variable, requireAdmin() fails CLOSED without it,
    // and a deploy that quietly removed it would lock everybody out of the CMS
    // with no error anywhere. Comma-separated, lowercase. Add an address here
    // and push; there is nothing to set in Cloudflare.
    "ADMIN_EMAILS": "mendy@aventary.com,musy@aventary.com"
  },
  "observability": {
    "enabled": true
  }
}
