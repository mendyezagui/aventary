[Unit]
Description=Vantaca email-action confirm page (/a + /act)
After=network-online.target vantaca-mcp.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/vantaca-mcp/email-actions
EnvironmentFile=/root/vantaca-mcp/.env
EnvironmentFile=-/root/vantaca-mcp/slack-bot/.env
Environment=EMAIL_ACTIONS_PORT=8788
ExecStart=/usr/bin/node /root/vantaca-mcp/email-actions/actions-server.mjs
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
