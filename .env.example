# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # server-only

# Second Brain (the product database, project ref fukehjqikxqsntwhmgsk).
# Read-only, server-only, and used for one thing: building the document at
# /c/<slug> from a published project's blocks. Without these two the site still
# serves authored and generated pages, so leaving them unset degrades rather
# than breaks. The service role key reads every tenant — never expose it to a
# browser, and never put it in a NEXT_PUBLIC_ variable.
SECOND_BRAIN_URL=https://fukehjqikxqsntwhmgsk.supabase.co
SECOND_BRAIN_SERVICE_ROLE_KEY=eyJ...   # server-only

# Resend (transactional email)
RESEND_API_KEY=re_...
CONTACT_TO_EMAIL=mendy@aventary.com
CONTACT_FROM_EMAIL=noreply@aventary.com

# Admin allowlist (comma-separated lowercase emails that can access /admin)
ADMIN_EMAILS=mendy@aventary.com

# Cloudflare Stream: the first label of your customer-<code>.cloudflarestream.com
# hostname (Stream dashboard). Without it, clip URLs fall back to videodelivery.net.
NEXT_PUBLIC_CLOUDFLARE_STREAM_SUBDOMAIN=

