# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # server-only

# Resend (transactional email)
RESEND_API_KEY=re_...
CONTACT_TO_EMAIL=mendy@aventary.com
CONTACT_FROM_EMAIL=noreply@aventary.com

# Admin allowlist (comma-separated lowercase emails that can access /admin)
ADMIN_EMAILS=mendy@aventary.com

# Carpool — Web Push (npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=B...      # same value as VAPID_PUBLIC_KEY
VAPID_PUBLIC_KEY=B...
VAPID_PRIVATE_KEY=...                  # server-only
VAPID_SUBJECT=mailto:mendy@aventary.com

# Carpool — optional
# NEXT_PUBLIC_CARPOOL_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# GEOCODER_USER_AGENT=AventaryCarpool/1.0 (+https://aventary.com)
