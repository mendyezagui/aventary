# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # server-only

# Second Brain (the product project, ref fukehjqikxqsntwhmgsk). Used for one
# thing: building the document at /c/<slug> from a published project's blocks.
#
# PAGE_FEED_SECRET is the shared secret for the project-page-feed edge function,
# and it is NOT a Supabase key. That is the point — this site can fetch published
# page content for one slug and nothing else, so a compromise here cannot reach
# anyone's CRM. The same value must be set as a secret on the Second Brain
# project. Server-only; never a NEXT_PUBLIC_ variable.
#
# Unset, project pages are simply not found and authored + generated pages still
# serve, so an unconfigured deploy degrades rather than breaks.
SECOND_BRAIN_URL=https://fukehjqikxqsntwhmgsk.supabase.co
PAGE_FEED_SECRET=

# Resend (transactional email)
RESEND_API_KEY=re_...
CONTACT_TO_EMAIL=mendy@aventary.com
CONTACT_FROM_EMAIL=noreply@aventary.com

# Admin allowlist (comma-separated lowercase emails that can access /admin)
ADMIN_EMAILS=mendy@aventary.com

# Cloudflare Stream: the first label of your customer-<code>.cloudflarestream.com
# hostname (Stream dashboard). Without it, clip URLs fall back to videodelivery.net.
NEXT_PUBLIC_CLOUDFLARE_STREAM_SUBDOMAIN=

